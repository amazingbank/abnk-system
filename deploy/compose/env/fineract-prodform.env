# ABNK Fineract 本地生产形态（WAR + 外部 Tomcat）env——字段范式对照
# fineract/config/docker/env/fineract-postgresql.env 与 fineract-common.env 实测。
#
# ⚠️ HOSTNAME 必须显式注入：application.properties 的
#    fineract.tenant.host=${FINERACT_DEFAULT_TENANTDB_HOSTNAME:localhost} 默认 localhost，
#    在 Tomcat 容器内不可达 PG（官方 war-test 栈经 fineract-common.env 注入 HOSTNAME=db 同理）。
#
# ⚠️ WAR 在外部 Tomcat 中运行时，Spring Boot 的内嵌容器 SSL 配置不生效；
#    connector 由 Tomcat 自带 server.xml 决定（平面 HTTP 8080），此处 SSL 开关仅作声明对齐。

# Hikari 连接（指向租户存储库 fineract_tenants）
FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME=org.postgresql.Driver
FINERACT_HIKARI_JDBC_URL=jdbc:postgresql://abnk-pg-prod:5432/fineract_tenants
FINERACT_HIKARI_USERNAME=root
FINERACT_HIKARI_PASSWORD=postgres

# 默认租户（default → fineract_default）连接参数（首启自动建租户记录）
FINERACT_DEFAULT_TENANTDB_HOSTNAME=abnk-pg-prod
FINERACT_DEFAULT_TENANTDB_PORT=5432
FINERACT_DEFAULT_TENANTDB_UID=root
FINERACT_DEFAULT_TENANTDB_PWD=postgres
FINERACT_DEFAULT_TENANTDB_IDENTIFIER=default
FINERACT_DEFAULT_TENANTDB_NAME=fineract_default

# Tomcat 平面 HTTP（生产形态口径：公网 TLS 终止在网关层）
FINERACT_SERVER_SSL_ENABLED=false

# JVM：容器内 Tomcat 运行 Fineract 需要的模块开放与堆上限
# （--add-opens 系列对照官方 war-test 栈 JAVA_TOOL_OPTIONS；去掉 jdwp 与 CI 专用 profile）
JAVA_TOOL_OPTIONS=-Xmx2G -XX:+UseContainerSupport --add-exports=java.naming/com.sun.jndi.ldap=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.security=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.management/javax.management=ALL-UNNAMED --add-opens=java.naming/javax.naming=ALL-UNNAMED
