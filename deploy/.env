# Amazing Bank 基础设施环境变量
#
# 本文件由 docker compose 自动读取（与 docker-compose.yml 同目录）。
# 这些值均为**本地开发默认值**，与 Fineract 代码内置默认值一致，故不属于敏感信息。
# 若要覆盖，复制为 .env.local 后修改（已在 .gitignore 中排除）。

# PostgreSQL 镜像版本
ABNK_PG_IMAGE_TAG=18.3

# 宿主映射端口
ABNK_PG_PORT=5432

# 超级用户账号（与 Fineract application.properties / createPGDB 任务默认值对齐）
ABNK_PG_USER=root
ABNK_PG_PASSWORD=postgres
ABNK_PG_DB=root

# 容器时区（影响日志时间戳；业务时区由 Fineract 应用侧配置）
ABNK_TZ=Asia/Shanghai

# 宿主日志目录（相对 compose 文件位置解析，默认 abnk-system/deploy/../../logs）。
# PostgreSQL 服务端日志会落到这里 → logs/postgres.log，与 Fineract 的 logs/fineract.log 并列
ABNK_LOGS_DIR=../../logs
