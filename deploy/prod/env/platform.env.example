# ABNK 平台栈（abnk-prod-platform）env 样例——占位符（public 仓）
#
# ⚠️ 本文件只是样例：真实值文件 = 服务器 ~/deploy/.env
#    源件归档 = .github-private/abnk-prod/platform.env（禁止进 public 仓）
#
# 用法（服务器，仓库根执行）：
#   docker compose --env-file ~/deploy/.env -f deploy/prod/compose-abnk-platform.yaml up -d
#
# 字段均为 compose 变量替换源（${ABNK_DEPLOY_ROOT:?} 等硬失败闸见 compose 文件头）。

# 部署根（WAR 与 initdb 脚本所在；卷挂载全经此路径，缺失硬失败）
ABNK_DEPLOY_ROOT=/home/<ssh-user>/deploy

# Fineract 镜像 tag（= fineract 仓 8 位短 hash——VP0.4.4 docker build -t abnk-fineract:<hash>）
ABNK_FINERACT_IMAGE_TAG=<fineract-short-hash>

# DB 凭据（PG 容器与 Fineract 双侧同源；POC 口径沿用开发栈值，真实值见私有仓源件）
ABNK_PG_USER=<db-user>
ABNK_PG_PASSWORD=<db-password>

# 时区（可省，默认 Asia/Shanghai）
# ABNK_TZ=Asia/Shanghai
