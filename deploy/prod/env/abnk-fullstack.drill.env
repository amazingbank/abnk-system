# ABNK 全栈本地演练 env（P3.4，VP3.4.2 实际值——开发口径，可入 public 仓）
#
# ⚠️ 与生产 .env 的区别：全部为开发占位值（DB root/postgres、JWT 开发密钥——
#    均为 public 仓既有开发口径，无生产敏感信息）；ABNK_DEPLOY_ROOT 指向本地
#    演练根（内含自签证书对与 initdb 脚本，gitignored）。异机重演改 DEPLOY_ROOT。
#
# 用法（$ABNK_REPO/deploy/prod 执行）：
#   docker compose -f compose-abnk-prod.yaml -f docker-compose.drill-override.yml \
#     --env-file env/abnk-fullstack.drill.env up -d

# 部署根 = 本地演练根（自签证书 nginx/ssl/ + initdb/；不入 git）
ABNK_DEPLOY_ROOT=/Users/leixu/source/asdm/amazingbank-ws/abnk-system/deploy/prod/.drill-root

# 镜像 tag（本地演练构建产物；fineract tag = fineract 仓 8 位短 hash）
ABNK_WEBSITE_IMAGE=abnk-website:0.1.2
ABNK_GATEWAY_IMAGE=abnk-gateway:0.1.0
ABNK_FINERACT_IMAGE=abnk-fineract:7b896ad6
ABNK_BO_IMAGE=abnk-bo:0.1.0
ABNK_MWEB_IMAGE=abnk-mweb:1.0.0

# DB 凭据（开发口径，与本地各栈一致）
ABNK_PG_USER=root
ABNK_PG_PASSWORD=postgres

# 网关 JWT 密钥（开发占位值——与网关 application.yml public 缺省一致）
ABNK_JWT_SECRET=abnk-dev-jwt-secret-0123456789abcdef-0123456789abcdef

# 时区
ABNK_TZ=Asia/Shanghai
