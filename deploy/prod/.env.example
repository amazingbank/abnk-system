# ABNK 生产部署根环境变量（模板——拷贝到服务器 ~/deploy/.env 后按需修改）
#
# compose 启动必须带 --env-file（AOS Iron Rule 21 口径）：
#   docker compose --env-file ~/deploy/.env -f deploy/prod/compose-abnk-prod.yaml up -d

# 部署根（宿主挂载锚点——缺失即 compose 硬失败）
ABNK_DEPLOY_ROOT=/home/azureuser/deploy

# 镜像 tag：发版流程每次 up 时显式注入（命令行 env 前缀），本文件不固化版本号
