.DS_Store

# Python
**/__pycache__/
*.pyc

# Node（channels/website 等前端）
node_modules/
dist/

# playwright-cli 浏览器会话缓存（走查截图已归档 artifacts/，会话数据不入库）
.playwright-cli/

# 环境与本地覆盖
deploy/compose/.env.local
**/.env.local

# 本地 prod 演练根（P3.4：自签证书对 + initdb 副本 + fineract WAR 等运行时物料，勿入库）
deploy/prod/.drill-root/

# 产物：只入库小 JSON 报告，排除运行中产物与临时文件
artifacts/**/*.log
artifacts/**/tmp/
artifacts/**/*.dump

# 运行时生成：种子脚本产出的环境特定映射（含 clientId/账户 id，随环境变化）
data/seed_demo_mapping.json

# 数据快照默认入库（小 JSON）；大体积导出按需显式排除：
# artifacts/**/*.csv

# IDE
.idea/
.vscode/

# Java/Gradle（channels/gateway 等 JVM 工程）
.gradle/
build/
src/*/build/

# VS Code Java language server 编译输出（bin/）
bin/
